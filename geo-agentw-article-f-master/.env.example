# Spring backend
DB_URL=jdbc:mysql://localhost:3306/geo_agent?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf8&allowPublicKeyRetrieval=false&useSSL=true&requireSSL=true
DB_USERNAME=
DB_PASSWORD=
DASHSCOPE_API_KEY=
APP_ADMIN_PASSWORD_HASH=
APP_STORAGE_PATH=C:/geo-agent/documents
APP_ALLOWED_CORS_ORIGINS=
SESSION_COOKIE_SECURE=false

# Qdrant
QDRANT_BASE_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=geo_agent_knowledge

# Internal Python publish service
PUBLISH_SERVICE_BASE_URL=http://127.0.0.1:5409
PUBLISH_INTERNAL_TOKEN=
PUBLISH_HOST=127.0.0.1
PUBLISH_PORT=5409
PUBLISH_ALLOWED_ORIGINS=
PUBLISH_MAX_UPLOAD_BYTES=20971520
SOCIAL_PUBLISH_BASE_DIR=C:/geo-agent/social-publish-data
LOCAL_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
LOCAL_CHROME_HEADLESS=true

# GEO monitoring. Configure engines in application-prod.yaml or another secure config source.
GEO_MONITOR_ENABLED=false
GEO_MONITOR_CRON="0 0 */6 * * ?"
GEO_MONITOR_BATCH_SIZE=20
GEO_MONITOR_STALE_HOURS=24
GEO_WORKER_BATCH_SIZE=8
GEO_WORKER_CONCURRENCY=3
GEO_PLATFORM_CONCURRENCY=1
GEO_PLATFORM_MIN_INTERVAL_MS=1200
GEO_WORKER_POLL_MS=15000
GEO_TASK_MAX_ATTEMPTS=2
GEO_TASK_RETRY_DELAY_MINUTES=10
GEO_AUTO_OPTIMIZATION_ENABLED=true
GEO_FEEDBACK_CONTEXT_LIMIT=4000
GEO_PROBE_ENABLED=true
GEO_PROBE_WORKER_BATCH_SIZE=4
GEO_PROBE_WORKER_CONCURRENCY=2
GEO_PROBE_POLL_MS=10000
GEO_PROBE_MAX_ROUNDS=2
GEO_OFFICIAL_DOMAINS=hztcm.cn
GEO_BAIDU_QIANFAN_ENABLED=false
BAIDU_QIANFAN_API_KEY=
GEO_BAIDU_QIANFAN_TOP_K=10
GEO_BAIDU_QIANFAN_RECENCY_FILTER=
