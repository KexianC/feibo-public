    "@webav/av-cliper": "^1.2.6",
    "@webav/av-recorder": "^1.2.6",
    "antd": "^6.3.3",
    "clsx": "^2.1.1",
    "event-source-polyfill": "^1.0.31",
    "file-saver": "^2.0.5",
    "konva": "^9.3.22",
    "lucide-react": "^0.511.0",
    "opfs-tools": "^0.7.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.7"
