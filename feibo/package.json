{
  "name": "feibo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "check:ai-model-id": "node scripts/verify-ai-model-id-contract.mjs",
    "check:auth-session": "node scripts/verify-auth-session.mjs",
    "check:compose-run-isolation": "node scripts/verify-compose-run-isolation.mjs",
    "check:voice": "node scripts/verify-voice-contract.mjs",
    "check:model-fallback": "node scripts/verify-model-fallback.mjs",
    "check:sensitive-logging": "node scripts/verify-sensitive-logging.mjs",
    "protect-images": "powershell -ExecutionPolicy Bypass -File scripts/protect-images.ps1",
    "dev-safe": "npm run protect-images && vite"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@types/file-saver": "^2.0.7",
