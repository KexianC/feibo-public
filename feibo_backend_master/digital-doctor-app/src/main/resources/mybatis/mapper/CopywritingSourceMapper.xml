<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.infrastructure.dao.CopywritingSourceMapper">
    <resultMap id="BaseResultMap" type="com.hzmwmt.infrastructure.dao.po.CopywritingSource">
        <id property="copywritingSourceId" column="copywriting_source_id"/>
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <select id="selectCopywritingSourceListByCopywritingSourceIds" resultMap="BaseResultMap">
        select copywriting_source_id ,name from t_copywriting_source where copywriting_source_id in
        <foreach item="item" index="index" collection="sourceIds" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
    <select id="selectAllValidCopywritingSource" resultMap="BaseResultMap">
        select copywriting_source_id, name
        from t_copywriting_source
        where status = 0
    </select>
</mapper>