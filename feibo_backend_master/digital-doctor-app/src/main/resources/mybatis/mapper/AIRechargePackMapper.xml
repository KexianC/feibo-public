<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.infrastructure.dao.AIRechargePackMapper">

    <resultMap id="BaseResultMap" type="com.hzmwmt.infrastructure.dao.po.AIRechargePack">
        <id property="aiRechargePackId" column="ai_recharge_pack_id"/>
        <result property="packCode" column="pack_code"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="price" column="price"/>
        <result property="value" column="value"/>
        <result property="aiFeatureTemplateId" column="ai_feature_template_id"/>
        <result property="isActive" column="is_active"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectValidAiRechargePack" resultMap="BaseResultMap">
        SELECT ai_recharge_pack_id,
               pack_code,
               name,
               description,
               price,
               value,
               ai_feature_template_id,
               is_active,
               create_time,
               update_time
        FROM t_ai_recharge_pack
        WHERE is_active = 0
        ORDER BY create_time DESC
    </select>

    <select id="selectValidAiRechargePackByAiRechargePackId" resultMap="BaseResultMap">
        SELECT ai_recharge_pack_id,
               pack_code,
               name,
               description,
               price,
               value,
               ai_feature_template_id,
               is_active,
               create_time,
               update_time
        FROM t_ai_recharge_pack
        WHERE ai_recharge_pack_id = #{aiRechargePackId}
          AND is_active = 0
    </select>

    <select id="selectAllAiRechargePack" resultMap="BaseResultMap">
        SELECT ai_recharge_pack_id,
               pack_code,
               name,
               description,
               price,
               value,
               ai_feature_template_id,
               is_active,
               create_time,
               update_time
        FROM t_ai_recharge_pack
        ORDER BY create_time DESC
    </select>

</mapper>