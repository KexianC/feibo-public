<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.infrastructure.dao.RoleMapper">
    <resultMap id="BaseResultMap" type="com.hzmwmt.infrastructure.dao.po.Role">
        <id property="roleId" column="role_id"/>
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <select id="selectRoleListByRoleIds" resultMap="BaseResultMap">
        select role_id,name,description from t_role where role_id in
        <foreach item="item" index="index" collection="roleIds" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
</mapper>