<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.infrastructure.dao.UserAISubscriptionMapper">
    <resultMap id="BaseResultMap" type="com.hzmwmt.infrastructure.dao.po.UserAISubscription">
        <id property="id" column="id"/>
        <result property="userAiSubscriptionId" column="user_ai_subscription_id"/>
        <result property="userId" column="user_id"/>
        <result property="aiMembershipPlanId" column="ai_membership_plan_id"/>
        <result property="orderId" column="order_id"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectUserAiSubscriptionListByUserId" resultMap="BaseResultMap">
        SELECT user_ai_subscription_id, ai_membership_plan_id, order_id, start_time, end_time, update_time
        FROM t_user_ai_subscription
        WHERE user_id = #{userId}
    </select>
</mapper>