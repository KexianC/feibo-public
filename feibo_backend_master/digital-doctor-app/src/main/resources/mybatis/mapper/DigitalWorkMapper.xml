<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.infrastructure.dao.DigitalWorkMapper">

    <resultMap id="BaseResultMap" type="com.hzmwmt.infrastructure.dao.po.DigitalWork">
        <id property="id" column="id"/>
        <result property="digitalWorkId" column="digital_work_id"/>
        <result property="userId" column="user_id"/>
        <result property="body" column="body"/>
        <result property="externalId" column="external_id"/>
        <result property="status" column="status"/>
        <result property="failureReason" column="failure_reason"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <select id="selectUserWorkListCursorPageByUserId" resultMap="BaseResultMap">
        select digital_work_id,title,body,external_id,status,failure_reason,create_time,update_time from t_digital_work
        <where>
            user_id = #{userId}
            AND quota_hidden = 0
            <if test="lastCursorId != null">
                AND digital_work_id &lt; #{lastCursorId}
            </if>
        </where>
        ORDER BY digital_work_id DESC
        LIMIT #{size}
    </select>
</mapper>
