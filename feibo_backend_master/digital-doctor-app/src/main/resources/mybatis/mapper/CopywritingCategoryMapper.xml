<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.infrastructure.dao.CopywritingCategoryMapper">
    <resultMap id="BaseResultMap" type="com.hzmwmt.infrastructure.dao.po.CopywritingCategory">
        <id property="copywritingCategoryId" column="copywriting_category_id"/>
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <select id="selectCopywritingCategoryListByCopywritingCategoryIds" resultMap="BaseResultMap">
        select copywriting_category_id ,name from t_copywriting_category where copywriting_category_id in
        <foreach item="item" index="index" collection="categoryIds" open="(" separator="," close=")">
            #{item}
        </foreach>
    </select>
    <select id="selectAllValidCopywritingCategory" resultMap="BaseResultMap">
        select copywriting_category_id, name
        from t_copywriting_category
        where status = 0
    </select>
</mapper>