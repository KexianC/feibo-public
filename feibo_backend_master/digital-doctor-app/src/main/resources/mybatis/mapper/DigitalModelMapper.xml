<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.infrastructure.dao.DigitalModelMapper">

    <resultMap id="BaseResultMap" type="com.hzmwmt.infrastructure.dao.po.DigitalModel">
        <id property="id" column="id"/>
        <result property="digitalModelId" column="digital_model_id"/>
        <result property="voiceId" column="voice_id"/>
        <result property="imageId" column="image_id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="avatar" column="avatar"/>
        <result property="gender" column="gender"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    <select id="selectDigitalModelCursorPageByUserId" resultMap="BaseResultMap">
        select digital_model_id,voice_id,image_id,gender,avatar,user_id,name from t_digital_model
        <where>
            where user_id = #{userId} and status = 0
            <if test="lastCursorId != null">
                AND digital_model_id &lt; #{lastCursorId}
            </if>
        </where>
        ORDER BY digital_model_id DESC
        LIMIT #{size}
    </select>

</mapper>