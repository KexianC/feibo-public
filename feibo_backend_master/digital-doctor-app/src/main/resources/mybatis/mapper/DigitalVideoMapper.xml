<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.infrastructure.dao.DigitalVideoMapper">

    <resultMap id="BaseResultMap" type="com.hzmwmt.infrastructure.dao.po.DigitalVideo">
        <id property="id" column="id"/>
        <result property="digitalVideoId" column="digital_video_id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="url" column="url"/>
        <result property="duration" column="duration"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectUserVideoListCursorPage" resultMap="BaseResultMap">
        SELECT id, digital_video_id, user_id, name, url, duration, create_time, update_time
        FROM t_digital_video
        <where>
            user_id = #{userId}
            <if test="lastCursorId != null">
                AND digital_video_id &lt; #{lastCursorId}
            </if>
        </where>
        ORDER BY digital_video_id DESC
        LIMIT #{size}
    </select>

    <select id="selectSysVideoListCursorPage" resultMap="BaseResultMap">
        SELECT id, digital_video_id, user_id, name, url, duration, create_time, update_time
        FROM t_digital_video
        <where>
            user_id IS NULL
            <if test="lastCursorId != null">
                AND digital_video_id &lt; #{lastCursorId}
            </if>
        </where>
        ORDER BY digital_video_id DESC
        LIMIT #{size}
    </select>

