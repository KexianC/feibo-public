<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hzmwmt.domain.mapper.packages.TAiMembershipPlanMapper">

    <!-- 查询所有有效的会员套餐 -->
    <select id="selectValidMembershipPlan" resultType="com.hzmwmt.domain.entity.packages.TAiMembershipPlan">
        SELECT *
        FROM t_ai_membership_plan
        WHERE is_active = 0
        ORDER BY create_time DESC
    </select>

    <!-- 根据套餐ID查询有效的会员套餐 -->
    <select id="selectValidMembershipPlanByAiMembershipPlanId"
            resultType="com.hzmwmt.domain.entity.packages.TAiMembershipPlan">
        SELECT *
        FROM t_ai_membership_plan
        WHERE ai_membership_plan_id = #{aiMembershipPlanId}
          AND is_active = 0
    </select>

    <!-- 根据套餐ID列表查询有效的会员套餐 -->
    <select id="selectValidMembershipPlanByAiMembershipPlanIds"
            resultType="com.hzmwmt.domain.entity.packages.TAiMembershipPlan">
        SELECT * FROM t_ai_membership_plan
        WHERE ai_membership_plan_id IN
        <foreach collection="aiMembershipPlanIds" item="item" index="index" open="(" close=")" separator=",">
            #{item}
        </foreach>
        AND is_active = 0
    </select>

    <!-- 查询默认的免费会员套餐 -->
    <select id="selectDefaultAiMembershipPlan" resultType="com.hzmwmt.domain.entity.packages.TAiMembershipPlan">
        SELECT *
        FROM t_ai_membership_plan
        WHERE plan_code = 'PLAN_FREE'
          AND is_active = 0 LIMIT 1
    </select>
</mapper>