/www/wwwlogs/dd.hzmwmt.com.log
/www/wwwlogs/dd.hzmwmt.com.error.log
/www/wwwlogs/manage.hzmwmt.com.log
/www/wwwlogs/manage.hzmwmt.com.error.log
/var/log/feibo-certbot-renew.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 www www
    sharedscripts
    postrotate
        /www/server/nginx/sbin/nginx -s reopen >/dev/null 2>&1 || true
    endscript
}
